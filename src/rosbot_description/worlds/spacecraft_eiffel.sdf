          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="crate2">
      <static>true</static>
      <pose>-7 -1 0.3 0 0 0</pose>
      <link name="crate">
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>

    </model>

    <model name="crate3">
      <static>true</static>
      <pose>-8 1 0.3 0 0 0</pose>
      <link name="crate">
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient></material>

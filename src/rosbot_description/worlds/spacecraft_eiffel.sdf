    <model name="engine_console2">
      <static>true</static>
      <pose>6.5 -0.8 0.3 0 0 0</pose>
      <link name="console">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>

    <!-- ============================================ -->
    <!--          GROUND FLOOR CORRIDORS             -->
    <!-- ============================================ -->

    <model name="ground_corridor">
      <static>true</static>
      <pose>0 -2.5 0 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>20 1.5 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>20 1.5 2.5</size></box></geometry>
        </collision>

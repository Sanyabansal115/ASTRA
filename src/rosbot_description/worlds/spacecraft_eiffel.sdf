    <!--           ELEVATOR / CENTRAL CORE           -->
    <!-- ============================================ -->

    <!-- Main Elevator Shaft -->
    <model name="elevator_shaft">
      <static>true</static>
      <pose>0 7.5 0 0 0 0</pose>
      <link name="shaft">
        <visual name="visual">
          <geometry><box><size>3 3 6</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>3 3 6</size></box></geometry>
        </collision>
      </link>
    </model>


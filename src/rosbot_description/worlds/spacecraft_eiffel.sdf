    <model name="hospital_bed2">
      <static>true</static>
      <pose>0.5 -0.5 0.2 0 0 0</pose>
      <link name="bed">
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.3</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>

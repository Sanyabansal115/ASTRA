    <!-- Vertical Corridors -->
    <model name="vertical_corridor_left">
      <static>true</static>
      <pose>-4 4 0 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>1.5 5 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>

<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="eiffel_spacecraft">

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <material><ambient>0.2 0.2 0.3 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!--            TOP FLOOR - COMMAND MODULE        -->
    <!-- ============================================ -->
    
    <!-- Spire (top antenna) -->
    <model name="spire">
      <static>true</static>
      <pose>0 15 6 0 0 0</pose>
      <link name="spire">
        <visual name="visual">
          <geometry><box><size>0.2 0.2 2</size></box></geometry>
          <material><ambient>0.8 0.8 0.9 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.2 0.2 2</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Command Module (Top - Blue) -->
    <model name="command_module">
      <static>true</static>
      <pose>0 12 0 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>6 6 4</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>6 6 4</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Command Module Windows -->
    <model name="command_windows">
      <static>true</static>
      <pose>0 12 2 0 0 0</pose>
      <link name="glass">
        <visual name="visual">
          <geometry><box><size>6.5 6.5 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.9 0.5</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ============================================ -->
    <!--            MIDDLE FLOOR - AIRLOCK            -->
    <!-- ============================================ -->

    <!-- Airlock (Middle Left - Green) -->
    <model name="airlock">
      <static>true</static>
      <pose>-4 8 0 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>4 4 3.5</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>4 4 3.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Docking Port -->
    <model name="docking_port">
      <static>true</static>
      <pose>-6 8 0 0 0 0</pose>
      <link name="port">
        <visual name="visual">
          <geometry><cylinder><radius>1.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>1.2</radius><length>0.5</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Sleeping Quarters (Middle Right - Red) -->
    <model name="sleeping_quarters">
      <static>true</static>
      <pose>4 8 0 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>4 4 3.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>4 4 3.5</size></box></geometry>
        </collision>
      </link>
    </model>


          <geometry><box><size>2.5 2.5 0.8</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.5 2.5 0.8</size></box></geometry>
        </collision>
      </link>

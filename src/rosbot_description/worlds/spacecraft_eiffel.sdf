      <link name="wall">
        <visual name="visual">
          <geometry><box><size>10 1.5 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 1.5 2.5</size></box></geometry>
        </collision>

<?xml version="1.0"?>
<!--
  ASTRA robot - rebuilt from scratch on Gazebo's NATIVE DiffDrive plugin.

  WHY THIS DESIGN:
  The previous version used gz_ros2_control + controller_manager + spawners.
  That stack has three separate places a parameter file can silently fail to
  load, and when it does the controller still reports "active" while doing
  nothing. We removed that entire layer. The DiffDrive plugin below is
  configured INLINE - wheel separation, radius, and topics are right here in
  this file. There is no external YAML for the drivetrain, so there is
  nothing to fail to load.

  GEOMETRY NOTE (this was also broken before):
  Wheel radius is 0.05 and the wheel joints sit at z=0.05, so the wheels
  touch the ground plane exactly. The caster (radius 0.03) sits at z=0.03.
  Previously base_footprint->base_link had a 0.05 offset that lifted every
  wheel 0.05m off the floor - the robot was resting on nothing.
-->
<robot name="astra_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Tune this if the astronaut renders huge or invisible. The glb's native
       units are unknown; 1.0 is the starting guess. Try 0.05 if it's giant. -->
  <xacro:property name="astronaut_scale" value="0.05"/>

  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- ============ BASE ============ -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.30 0.24 0.16"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.30 0.24 0.16"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.13"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- No z offset: base_link frame sits at ground level, wheels reach the floor -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============ WHEELS ============ -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_offset} 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_offset="0.14"/>
  <xacro:wheel prefix="right" y_offset="-0.14"/>

  <!-- ============ CASTER ============ -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.11 0 0.03" rpy="0 0 0"/>
  </joint>
  <!-- Near-frictionless so the caster slides instead of fighting the drive wheels -->
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============ ASTRONAUT SKIN (visual only, no collision) ============ -->
  <!-- The glb is 13.997 m tall in its own units and its origin sits at the TOP
       of the head, so the body hangs DOWNWARDS from the mount point. Mounting
       it at the deck height therefore buried ~70% of the astronaut under the
       floor. MESH_DROP is how far the feet fall below the origin, so the mount
       has to be raised by exactly that much to stand the astronaut on the deck. -->
  <xacro:property name="deck_z"    value="0.21"/>
  <xacro:property name="mesh_drop" value="14.0976"/>

  <link name="astronaut_visual">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://astra_robot/meshes/cute_astronaut.glb"
              scale="${astronaut_scale} ${astronaut_scale} ${astronaut_scale}"/>
      </geometry>
    </visual>
    <!-- Negligible mass: this link is decoration. Without an explicit inertial
         the URDF->SDF conversion can lump a default mass in at the mount point,
         which is now ~0.9 m up and would raise the centre of mass enough to
         make the robot pitch. -->
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="astronaut_visual_joint" type="fixed">
    <parent link="base_link"/>
    <child link="astronaut_visual"/>
    <origin xyz="0 0 ${deck_z + mesh_drop * astronaut_scale}" rpy="0 0 0"/>
  </joint>

  <!-- Draw the astronaut for the GUI camera but hide it from the LiDAR. The
       sensor's visibility_mask below clears bit 0, so a visual flagged as bit 0
       only is skipped by the ray cast while everything else (walls, crates,
       which keep the default 0xFFFFFFFF) is still seen. Without this the
       astronaut's legs stand in the LiDAR plane at z=0.30 and blind it. -->
  <gazebo reference="astronaut_visual">
    <visual>
      <visibility_flags>1</visibility_flags>
    </visual>
  </gazebo>

  <!-- ============ LIDAR ============ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.03"/></geometry>
      <material name="dark"/>
    </visual>
    <collision><geometry><cylinder radius="0.03" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 0.30" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <!-- 0xFFFFFFFE - every visibility bit except bit 0. The astronaut visual
           is flagged bit 0 only, so this ray cast ignores it; walls and crates
           keep the default flags and are still detected. -->
      <visibility_mask>4294967294</visibility_mask>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============ GAZEBO SYSTEM PLUGINS ============ -->
  <gazebo>
    <!-- NOTE: gz-sim-sensors-system is a WORLD plugin and lives in
         worlds/spacecraft_clean.sdf, not here. Declaring it at model scope
         does not reliably start the render pass, which leaves /scan silent. -->
    <!-- Publishes wheel joint states so RViz can animate the wheels -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <!-- THE DRIVETRAIN. Everything it needs is right here - no external YAML.
         Subscribes to gz topic /cmd_vel (gz.msgs.Twist), publishes odom and
         the odom->base_footprint TF. The ros_gz_bridge maps these to ROS. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>

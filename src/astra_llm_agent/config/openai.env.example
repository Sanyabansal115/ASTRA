# ASTRA LLM agent - API key template (same layout as the Week 12 lab's
# config/openai.env).
#
# Copy this file to config/openai.env and put the shared lab key in it:
#
#     cp config/openai.env.example config/openai.env
#     nano config/openai.env          # fill in MISTRAL_API_KEY=
#     colcon build --packages-select astra_llm_agent
#
# config/openai.env is listed in .gitignore, so the real key never reaches
# GitHub. This .example file is the only one that is committed, and it must
# always stay empty.
#
# The agent looks for the key in this order:
#   1. the MISTRAL_API_KEY environment variable        <- simplest, no rebuild
#        export MISTRAL_API_KEY=your_key_here
#   2. ~/.astra_llm/openai.env                         <- outside the repo
#        mkdir -p ~/.astra_llm
#        echo 'MISTRAL_API_KEY=your_key_here' > ~/.astra_llm/openai.env
#   3. config/openai.env (this file, copied and filled in)

# Only Mistral is used by this package; the OpenAI entries are kept so the
# file matches the lab template.
OPENAI_API_KEY=
OPENAI_API_VERSION=
OPENAI_API_TYPE=
MISTRAL_API_KEY=

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astra_llm_agent</name>
  <version>0.1.0</version>
  <description>
    ASTRA LLM navigation agent: turns natural-language instructions received on
    /prompt into Nav2 NavigateToPose goals, using Mistral AI through LangChain.
    High-level command layer only - Nav2 still does all planning and control.
  </description>
  <maintainer email="aabdal35@my.centennialcollege.ca">Aboud Elzubair - LLM integration</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- langchain and langchain-mistralai are installed with pip into the
       workspace virtualenv (see README); they have no rosdep keys. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="spacecraft_clean">

    <!-- ====== BRIGHT LIGHTING ====== -->
    
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>0 -0.3 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <cast_shadows>false</cast_shadows>

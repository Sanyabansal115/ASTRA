<?xml version="1.0"?>
<robot name="rosbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="astronaut_skin">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find rosbot_description)/meshes/cute_astronaut.glb" scale="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>
  <joint name="astronaut_skin_joint" type="fixed">
    <parent link="base_link"/>
    <child link="astronaut_skin"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>
</robot>
